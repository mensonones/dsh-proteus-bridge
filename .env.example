# Copy to .env and fill in. The launcher (dsh-cybersec.sh) sources this file.

# --- DeepSeek official API ---
DEEPSEEK_API_KEY=sk-your-key-here
# Default endpoint; only change to use an OpenAI-compatible backend.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Local model via Ollama (OpenAI-compatible) — uncomment to use instead ---
# DEEPSEEK_BASE_URL=http://localhost:11434/v1
# DEEPSEEK_API_KEY=ollama            # any non-empty value

# --- Telemetry is OFF by default. Do NOT set this unless you want to send data. ---
# DSH_TELEMETRY_MODE=DISABLED

# --- Optional: Proteus integration (opt-in) ---
# Point at a Proteus checkout to enable its MCP engine + skills + agents.
# PROTEUS_DIR=/path/to/Proteus
